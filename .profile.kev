[ -f "$HOME/.papaya" ] && source "$HOME/.papaya"

export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.cargo/bin:$PATH"

# Aliases
declare -x COLORTERM="truecolor"
export PS1='\[\e[34m\] λ \W \[\e[0m\]'

# Git aliases
alias gf='git fetch'
alias gita='git commit --amend --no-edit'
alias gitac='git add ../* -u && git commit -m'
alias gitsuno='git status -suno'
alias gitpf='git push -u origin $(current_branch) --force-with-lease'
alias gitlone='git log --oneline'
alias gitadu='git add -u '
alias gitcom='git commit -m'
alias gco='git checkout'
alias git_is_ancestor='git merge-base --is-ancestor'
alias reb='git rebase'
alias gitu="git status -s | grep ^U | awk '{print $2}'"
alias gitus='git submodule update --init --recursive && git submodule update --recursive --remote'
alias gclean='git clean -fdx'
alias fix_git_ref='git --no-optional-locks fetch --prune origin '
alias git_clean_branch='export CURRENT_BRANCH=$(current_branch) && gco -f develop && git branch -D $CURRENT_BRANCH && gf && gco -f $CURRENT_BRANCH'
alias git_find_fork_point='git merge-base --fork-point'

# General aliases
alias grep='grep --color=auto'
alias gr='grep -rn'
alias grl='gr -l'
alias compntest='comp && test'
alias pgdb='gdb --pid'
alias ls='eza --color=always --icons=always -lhG --no-permissions --no-user'
alias lah='eza --color=always --icons=always -lahG'
alias lt='ls --tree --level=2'
alias l='ls'
alias ctar='tar -cvf'
alias change_bash='nvim $MY_DISK/dotfiles/.profile.kev && source $MY_DISK/dotfiles/.profile.kev'
alias game='tmux attach -t NetHack || tmux new -s NetHack'
alias nv='nvim'
alias ask_copito='copilot --allow-all-tools -p'
alias notif='echo "**** NOTIF NOW RUNNING****"&&${ANIMATE} ${NOTIF_GIF_SUCC}'
alias nv='nvim'
alias gotonvim='cd $MY_DISK/.config/nvim'
alias copito_review='copilot --agent pr-review-orchestrator'
alias zc='docker exec zeroclaw zeroclaw'

alias change_bash_local='nvim $MY_DISK/.profile.$USER.local && source $MY_DISK/.profile.$USER.local'

# My functions
function lg() {
  if [ -z "$2" ]; then
    ls | grep "$1"
  else
    ls "$1" | grep "$2"
  fi
}

al() {
    if [ "$1" = "-p" ]; then
        if [ $# -ne 3 ]; then
            echo "Usage: al <-p (permanent)> <name> <command>"
            return 1
        fi
        alias "$2"="$3"
        echo "alias $2=\"$3\"" >> $ALIAS_FILE
    else
        if [ $# -ne 2 ]; then
            echo "Usage: al <name> <command>"
            return 1
        fi
        alias "$1"="$2"
    fi
}



upto () 
{ 
    local EXPRESSION="$1";
    if [ -z "$EXPRESSION" ]; then
        echo "A folder expression must be provided." 1>&2;
        return 1;
    fi;
    if [ "$EXPRESSION" = "/" ]; then
        cd "/";
        return 0;
    fi;
    local CURRENT_FOLDER="$(pwd)";
    local MATCHED_DIR="";
    local MATCHING=true;
    while [ "$MATCHING" = true ]; do
        if [[ "$CURRENT_FOLDER" =~ "$EXPRESSION" ]]; then
            MATCHED_DIR="$CURRENT_FOLDER";
            CURRENT_FOLDER=$(dirname "$CURRENT_FOLDER");
        else
            MATCHING=false;
        fi;
    done;
    if [ -n "$MATCHED_DIR" ]; then
        cd "$MATCHED_DIR";
        return 0;
    else
        echo "No Match." 1>&2;
        return 1;
    fi
}

gitriba() {
  if [ "$#" -ne 1 ]; then
    echo "Usage: git-rebase-onto-merge-base <branch>"
    return 1
  fi

  local current_branch=$(git rev-parse --abbrev-ref HEAD)
  local given_branch=$1
  local base=$(git merge-base "$current_branch" "$given_branch")

  if [ -z "$base" ]; then
    echo "Could not find a common ancestor for branches $current_branch and $given_branch"
    return 1
  fi

  git rebase -i "$base"
}

if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
else
    echo "Warn!! Missing zoxide binary"
fi

copy() {
  local input
  input=$(cat)

  if [ -n "$TMUX" ]; then
    printf '%s' "$input" | tmux load-buffer -
    echo "✓ Copied to tmux buffer" >&2
  elif [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy &>/dev/null; then
    printf '%s' "$input" | wl-copy
    echo "✓ Copied via wl-copy" >&2
  else
    echo "copy: no clipboard method available" >&2
    return 1
  fi
}

